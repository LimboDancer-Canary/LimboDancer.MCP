@page "/"
@using AslHexMap.Core.Rendering
@using AslHexMap.Services
@inject JsonBoardLoader Loader

<PageTitle>Board</PageTitle>

<div class="container-fluid py-3">
    <!-- Toolbar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">ASL Board — Generated from JSON</h5>
        <div class="btn-toolbar gap-2">
            <button class="btn btn-sm btn-primary" @onclick="LoadSample">Load Sample JSON</button>
            <button class="btn btn-sm btn-secondary" @onclick="ShowGrid">Show Grid 5x4</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ShowTest">Show TEST SVG</button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Map column -->
        <div class="col-12 col-xl">
            <div class="bg-white rounded-3 shadow-sm p-2">
                <SvgHost Svg="@_svg" Debug="false" @key="_svg" />
            </div>
            @* Optional little debug readout *@
            <div class="small text-muted mt-2">Current: @_current &nbsp;|&nbsp; SVG Length: @_svg?.Length</div>
        </div>

        <!-- Legend column -->
        <div class="col-12 col-md-5 col-lg-4 col-xl-3">
            <div class="position-sticky" style="top: 1rem;">
                <div class="bg-white rounded-3 shadow-sm p-2">
                    <SvgHost Svg="@_legendSvg" Debug="false" @key="_legendSvg" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _svg = string.Empty;
    private string _legendSvg = string.Empty;
    private string _current = "none";

    protected override void OnInitialized()
    {
        // Start with a tiny grid so page isn't empty
        _svg = Renderer.RenderHexGrid(5, 4, 36, "grain");
        var usage = LegendRenderer.CreateUsage();
        usage.Bases.Add("grain");
        _legendSvg = LegendRenderer.BuildLegendSvg(usage, hexSize: 14, title: "Map Legend");
        _current = "GRID";
    }

    private void ShowTest()
    {
        _current = "TEST";
        _svg = Renderer.RenderTestSvg();
        _legendSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 10 10'></svg>";
    }

    private void ShowGrid()
    {
        _current = "GRID";
        _svg = Renderer.RenderHexGrid(cols: 5, rows: 4, size: 36, baseTerrain: "grain");
        var usage = LegendRenderer.CreateUsage();
        usage.Bases.Add("grain");
        _legendSvg = LegendRenderer.BuildLegendSvg(usage, hexSize: 14, title: "Map Legend");
    }

    private async Task LoadSample()
    {
        var data = await Loader.LoadSampleAsync(); // expects file in AslHexMap/Data/...
        if (data is null)
        {
            _current = "NO_JSON";
            _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 10 10'></svg>";
            _legendSvg = _svg;
            return;
        }

        var usage = LegendRenderer.CreateUsage();
        // NOTE: Renderer will populate usage.Bases (and, later, Buildings) as it draws.
        _svg = Renderer.RenderBoardBase(data, size: 36, showLabels: true, showRoads: true, usage: usage);
        _legendSvg = LegendRenderer.BuildLegendSvg(usage, hexSize: 14, title: "Map Legend");
        _current = "JSON";
    }
}
