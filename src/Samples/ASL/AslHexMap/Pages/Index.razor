@page "/"

@using AslHexMap.Core.Schema
@using AslHexMap.Core.Rendering
@inject AslHexMap.Services.JsonBoardLoader Loader
@inject AslHexMap.Services.LegendService Legend

<div class="container-fluid py-3">
    <div class="row g-3">
        <!-- Controls -->
        <div class="col-12">
            <div class="d-flex flex-wrap align-items-end gap-3">
                <div>
                    <label class="form-label mb-1">JSON file</label>
                    <input class="form-control" style="min-width: 320px;"
                           @bind="_fileName" @bind:event="oninput" />
                </div>

                <div>
                    <label class="form-label mb-1">Hex size</label>
                    <input type="number" class="form-control" style="width: 110px;"
                           min="18" max="72" step="2"
                           @bind="_size" @bind:event="oninput" @bind:after="RebuildAsync" />
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="chkLabels"
                           @bind="_showLabels" @bind:after="RebuildAsync" />
                    <label class="form-check-label" for="chkLabels">Labels</label>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="chkRoads"
                           @bind="_showRoads" @bind:after="RebuildAsync" />
                    <label class="form-check-label" for="chkRoads">Roads</label>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="chkFeatures"
                           @bind="_useFeatures" @bind:after="RebuildAsync" />
                    <label class="form-check-label" for="chkFeatures">Feature overlays</label>
                </div>

                <button class="btn btn-primary mt-3" @onclick="LoadAndRenderAsync">
                    Load & Render
                </button>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="text-danger ms-2">@_error</div>
                }
            </div>
        </div>

        <!-- Map + Legend -->
        <div class="col-12 col-lg-9">
            <div class="border rounded p-2 bg-white" style="min-height: 360px; overflow:auto;">
                @if (!string.IsNullOrEmpty(_svg))
                {
                    @((MarkupString)_svg)
                }
                else
                {
                    <div class="text-muted">Load a JSON map to render…</div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-3">
            <div class="border rounded p-3 bg-white">
                <h6 class="mb-3">Legend</h6>

                @if (_legendBase.Count == 0 && _legendBuildings.Count == 0)
                {
                    <div class="text-muted">No items to display yet.</div>
                }
                else
                {
                    @if (_legendBase.Count > 0)
                    {
                        <div class="mb-3">
                            <div class="fw-semibold small text-uppercase text-secondary mb-1">Base Terrain</div>
                            <ul class="list-unstyled mb-0">
                                @foreach (var it in _legendBase)
                                {
                                    <li class="mb-1 d-flex align-items-center gap-2">
                                        <span class="legend-swatch">
                                            @((MarkupString)Renderer.RenderLegendIcon(it.Token, 14))
                                        </span>
                                        <span>@it.Label</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_legendBuildings.Count > 0)
                    {
                        <div class="mb-0">
                            <div class="fw-semibold small text-uppercase text-secondary mb-1">Building Features</div>
                            <ul class="list-unstyled mb-0">
                                @foreach (var it in _legendBuildings)
                                {
                                    <li class="mb-1 d-flex align-items-center gap-2">
                                        <span class="legend-swatch">
                                            @((MarkupString)Renderer.RenderLegendIcon(it.Token, 14))
                                        </span>
                                        <span>@it.Label</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                }
            </div>
        </div>
    </div>
</div>

@code {
    // --- UI State ---
    private string _fileName = "asl_board_features_demo.json";
    private double _size = 36;
    private bool _showLabels = true;
    private bool _showRoads = true;
    private bool _useFeatures = true;

    private string _svg = "";
    private string _error = "";

    private BoardData? _board;
    private LegendRenderer.LegendUsage _usage = new();

    // Legend view-model slices
    private List<(string Token, string Label)> _legendBase = new();
    private List<(string Token, string Label)> _legendBuildings = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAndRenderAsync();
    }

    private async Task LoadAndRenderAsync()
    {
        _error = "";
        try
        {
            _board = await Loader.LoadSampleAsync(_fileName);
            await RebuildAsync();
        }
        catch (Exception ex)
        {
            _board = null;
            _svg = "";
            _legendBase.Clear();
            _legendBuildings.Clear();
            _error = ex.Message;
            StateHasChanged();
        }
    }

    private async Task RebuildAsync()
    {
        if (_board is null)
        {
            _svg = "";
            _legendBase.Clear();
            _legendBuildings.Clear();
            StateHasChanged();
            return;
        }

        _usage = new LegendRenderer.LegendUsage();

        _svg = Renderer.RenderBoardBase(
          _board,
          size: _size,
          showLabels: _showLabels,
          showRoads: _showRoads,
          usage: _usage,
          useFeatureOverlays: _useFeatures);

        await BuildLegendAsync();
        StateHasChanged();
    }

    private async Task BuildLegendAsync()
    {
        var tokens = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        // base terrains
        foreach (var b in _usage.Bases)
            tokens.Add($"base-{b}");

        // building features (bridge to new legend tokens)
        foreach (var b in _usage.Buildings)
        {
            if (b.Equals("wood", StringComparison.OrdinalIgnoreCase)) tokens.Add("building-wood");
            else if (b.Equals("stone2", StringComparison.OrdinalIgnoreCase)) tokens.Add("building-stone2");
        }

        var model = await Legend.LoadAsync();
        var labelMap = await Legend.LabelsForAsync(tokens);

        _legendBase = new();
        _legendBuildings = new();

        foreach (var sec in model.Sections)
        {
            if (sec.Title.Equals("Base Terrain", StringComparison.OrdinalIgnoreCase))
            {
                foreach (var it in sec.Items)
                    if (labelMap.TryGetValue(it.Token, out var lbl))
                        _legendBase.Add((it.Token, lbl));
            }
            else if (sec.Title.Equals("Building Features", StringComparison.OrdinalIgnoreCase))
            {
                foreach (var it in sec.Items)
                    if (labelMap.TryGetValue(it.Token, out var lbl))
                        _legendBuildings.Add((it.Token, lbl));
            }
        }
    }
}
